# ╔════════════════════════════════════════════════════════════════════════╗
# ║ construct-rti.sparql  ·  RTI provenance triples (one dataset)          ║
# ╠════════════════════════════════════════════════════════════════════════╣
# ║ From RelightLab provenance JSON + info.json, per dataset.              ║
# ║                                                                        ║
# ║ SECTION MAP                                                            ║
# ║   1 · Prefixes                                                         ║
# ║   2 · CONSTRUCT — output graph shape                                   ║
# ║   3 · WHERE — provenance JSON · info.json · identity · IRIs · labels   ║
# ╚════════════════════════════════════════════════════════════════════════╝
#
# Builds: Dataset -> RTI distribution + processing MeasurementCollection
#         (nplanes · quality · basis · web-layout · cpm · openlime · crop).
# Aligned to rupemagna-rti-1_5.ttl: single rpm-rti: namespace. RelightLab
# itself (rpm-rti:software-relightlab) is now a fully static chs:Software
# individual declared once in shared.ttl (title/version/page/label) — no
# longer re-asserted per dataset here; construct-provenance.sparql links the
# RTIFitting activity to it. All 7 processing measurement types are now
# declared add:MeasurementType individuals in rupemagna-rti-1_5.ttl: nplanes
# and crop-origin under their original PTM names (rpm-rti:mtype-ptm-nplanes /
# -ptm-crop-origin); quality, basis-type, web-layout, colour-profile-mode and
# the openlime flag were added there as rpm-rti:mtype-jpeg-quality /
# -rti-basis-type / -rti-web-layout / -rti-color-profile-mode / -rti-openlime
# once it turned out the pipeline was already emitting them with no declared
# home (esp. PTM-vs-HSH basis type — real technical metadata worth keeping).
# INPUT: PROV_LOCATION_PLACEHOLDER · INFO_LOCATION_PLACEHOLDER (semRTI.py).

# ════════════════════════════════════════════════════════════════════════
# 1 · PREFIXES
# ════════════════════════════════════════════════════════════════════════
PREFIX fx:     <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:    <http://sparql.xyz/facade-x/data/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:    <http://www.w3.org/2002/07/owl#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX dcat:   <http://www.w3.org/ns/dcat#>
PREFIX a-dd:   <https://w3id.org/arco/ontology/denotative-description/>
PREFIX chs:    <http://www.ontologydesignpatterns.org/cp/owl/culturalheritagesurvey.owl#>
PREFIX muapit: <https://w3id.org/italia/onto/MU/>
PREFIX schema: <https://schema.org/>
PREFIX foaf:   <http://xmlns.com/foaf/0.1/>
PREFIX prov:   <http://www.w3.org/ns/prov#>
PREFIX geo:    <http://www.opengis.net/ont/geosparql#>

PREFIX rpm-rti: <https://w3id.org/rupemagna-rti/ontology#>

# ════════════════════════════════════════════════════════════════════════
# 2 · CONSTRUCT  ·  output graph shape
# ════════════════════════════════════════════════════════════════════════
CONSTRUCT {

  ### RTI.1  Dataset → RTI distribution ###
  ?dataURI dcat:distribution ?distURI .

  ### RTI.2  RTI distribution ###
  ?distURI
    a owl:NamedIndividual, dcat:Distribution, chs:Result ;
    dct:title ?distTitle ;
    dct:format ?formatLabel ;
    schema:width ?width ;
    schema:height ?height ;
    dct:creator rpm-rti:agent-huseyin-erdogan ;
    dct:license <LICENSE_URL_PLACEHOLDER> ;
    dct:created ?started ;
    dct:identifier ?uuid ;
    prov:wasGeneratedBy ?surveyURI ;
    dct:spatial rpm-rti:site-rupe-magna ;
    a-dd:hasMeasurementCollection ?mcollURI ;
    rdfs:label ?distLabel .

  ### RTI.3  Measurement collection + measurements ###
  ?mcollURI
    a owl:NamedIndividual, a-dd:MeasurementCollection ;
    rdfs:label ?mcollLabel ;
    a-dd:hasMeasurement
      ?measNplanes, ?measQuality, ?measType,
      ?measWeblayout, ?measCpm, ?measOpenlime, ?measCrop .

  ?measNplanes
    a owl:NamedIndividual, a-dd:Measurement ;
    a-dd:measurementType rpm-rti:mtype-ptm-nplanes ;
    muapit:value ?nplanes ;
    rdfs:label ?labelNplanes .

  ?measQuality
    a owl:NamedIndividual, a-dd:Measurement ;
    a-dd:measurementType rpm-rti:mtype-jpeg-quality ;
    muapit:value ?quality ;
    rdfs:label ?labelQuality .

  ?measType
    a owl:NamedIndividual, a-dd:Measurement ;
    a-dd:measurementType rpm-rti:mtype-rti-basis-type ;
    muapit:value ?basisUpper ;
    rdfs:label ?labelType .

  ?measWeblayout
    a owl:NamedIndividual, a-dd:Measurement ;
    a-dd:measurementType rpm-rti:mtype-rti-web-layout ;
    muapit:value ?webLayoutLc ;
    rdfs:label ?labelWeblayout .

  ?measCpm
    a owl:NamedIndividual, a-dd:Measurement ;
    a-dd:measurementType rpm-rti:mtype-rti-color-profile-mode ;
    muapit:value ?cpm ;
    rdfs:label ?labelCpm .

  ?measOpenlime
    a owl:NamedIndividual, a-dd:Measurement ;
    a-dd:measurementType rpm-rti:mtype-rti-openlime ;
    muapit:value ?openlime ;
    rdfs:label ?labelOpenlime .

  ?measCrop
    a owl:NamedIndividual, a-dd:Measurement ;
    a-dd:measurementType rpm-rti:mtype-ptm-crop-origin ;
    muapit:value ?cropStr ;
    rdfs:label ?labelCrop .
}

# ════════════════════════════════════════════════════════════════════════
# 3 · WHERE  ·  query logic (data → variables)
# ════════════════════════════════════════════════════════════════════════
WHERE {

  ###################################################################
  # Provenance JSON — identity + processing delta
  ###################################################################
  SERVICE <x-sparql-anything:PROV_LOCATION_PLACEHOLDER> {
    ?root xyz:uuid       ?uuidRaw ;
          xyz:startedAt  ?startedRaw ;
          xyz:output     ?outPath ;
          xyz:software   ?sw ;
          xyz:parameters ?params .
    ?sw     xyz:version  ?swVersion .
    ?params xyz:openlime ?openlimeRaw ;
            xyz:format   ?formatRaw ;
            xyz:webLayout ?webLayoutRaw ;
            xyz:colorProfileMode ?cpmRaw ;
            xyz:crop     ?crop .
    ?crop xyz:left ?cropX ; xyz:top ?cropY ; xyz:angle ?cropAngle .
  }

  ###################################################################
  # info.json — authoritative technical scalars
  ###################################################################
  SERVICE <x-sparql-anything:INFO_LOCATION_PLACEHOLDER> {
    ?iroot xyz:nplanes ?nplanesRaw ;
           xyz:quality ?qualityRaw ;
           xyz:type    ?basisLc ;
           xyz:width   ?widthRaw ;
           xyz:height  ?heightRaw .
  }

  # ---- identity derived from the output path  .../<figure>/<session>/<type>
  BIND(REPLACE(?outPath, ".*/([^/]+)$", "$1")                 AS ?type)
  BIND(REPLACE(?outPath, ".*/([^/]+)/([^/]+)$", "$1")         AS ?session)
  BIND(REPLACE(?session, "-", "")                             AS ?sessionFlat)
  BIND(STR(?uuidRaw)                                          AS ?uuid)
  BIND(xsd:dateTime(?startedRaw)                              AS ?started)
  BIND(UCASE(?basisLc)                                        AS ?basisUpper)
  BIND(xsd:integer(?nplanesRaw)                               AS ?nplanes)
  BIND(xsd:integer(?qualityRaw)                               AS ?quality)
  BIND(xsd:integer(?widthRaw)                                 AS ?width)
  BIND(xsd:integer(?heightRaw)                                AS ?height)
  # colour-profile mode: map RelightLab enum names to readable labels
  BIND(IF(?cpmRaw = "COLOR_PROFILE_LINEAR_RGB", "Linear RGB",
       IF(?cpmRaw = "COLOR_PROFILE_SRGB",       "sRGB",
       IF(?cpmRaw = "COLOR_PROFILE_DISPLAY_P3", "Display P3", ?cpmRaw))) AS ?cpm)
  BIND(LCASE(?webLayoutRaw)                                   AS ?webLayoutLc)
  BIND(xsd:boolean(?openlimeRaw)                              AS ?openlime)
  BIND(CONCAT("x=", STR(?cropX), " y=", STR(?cropY), " angle=", STR(?cropAngle)) AS ?cropStr)
  BIND(CONCAT("RTI (", STR(?formatRaw), ")")                 AS ?formatLabel)

  # ---- IRIs
  BIND(IRI(CONCAT("https://w3id.org/rupemagna-rti/ontology#data-", ?session))                       AS ?dataURI)
  BIND(IRI(CONCAT("https://w3id.org/rupemagna-rti/ontology#survey-", ?session))                     AS ?surveyURI)
  BIND(IRI(CONCAT("https://w3id.org/rupemagna-rti/ontology#dist-", ?session, "-", ?type))           AS ?distURI)
  BIND(IRI(CONCAT("https://w3id.org/rupemagna-rti/ontology#mcoll-", ?session, "-", ?type))          AS ?mcollURI)
  BIND(IRI(CONCAT("https://w3id.org/rupemagna-rti/ontology#meas-", ?session, "-", ?type, "-nplanes"))  AS ?measNplanes)
  BIND(IRI(CONCAT("https://w3id.org/rupemagna-rti/ontology#meas-", ?session, "-", ?type, "-quality"))  AS ?measQuality)
  BIND(IRI(CONCAT("https://w3id.org/rupemagna-rti/ontology#meas-", ?session, "-", ?type, "-type"))     AS ?measType)
  BIND(IRI(CONCAT("https://w3id.org/rupemagna-rti/ontology#meas-", ?session, "-", ?type, "-weblayout")) AS ?measWeblayout)
  BIND(IRI(CONCAT("https://w3id.org/rupemagna-rti/ontology#meas-", ?session, "-", ?type, "-cpm"))      AS ?measCpm)
  BIND(IRI(CONCAT("https://w3id.org/rupemagna-rti/ontology#meas-", ?session, "-", ?type, "-openlime")) AS ?measOpenlime)
  BIND(IRI(CONCAT("https://w3id.org/rupemagna-rti/ontology#meas-", ?session, "-", ?type, "-croporigin")) AS ?measCrop)

  # ---- labels
  BIND(CONCAT(?basisUpper, " distribution — ", ?session)               AS ?distLabel)
  BIND(CONCAT(?basisUpper, " output — ", ?session)                     AS ?distTitle)
  BIND(CONCAT("RTI processing parameters — ", ?session)                AS ?mcollLabel)
  BIND(CONCAT(?basisUpper, " planes: ", STR(?nplanes), " — ", ?session) AS ?labelNplanes)
  BIND(CONCAT("JPEG quality: ", STR(?quality), " — ", ?session)        AS ?labelQuality)
  BIND(CONCAT("RTI basis type: ", ?basisUpper, " — ", ?session)        AS ?labelType)
  BIND(CONCAT("Web layout: ", ?webLayoutLc, " — ", ?session)           AS ?labelWeblayout)
  BIND(CONCAT("Colour profile mode: ", STR(?cpm), " — ", ?session)     AS ?labelCpm)
  BIND(CONCAT("OpenLime viewer: ", STR(?openlime), " — ", ?session)    AS ?labelOpenlime)
  BIND(CONCAT("Crop origin — ", ?session)                              AS ?labelCrop)
}
